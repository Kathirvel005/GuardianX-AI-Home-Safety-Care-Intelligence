# GuardianX Environment Configuration Template
# Copy this file to .env or backend/.env

# Node Server Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Ring Integration Configuration
# RING_MODE: "demo" (default fallback with rich simulation), "simulator" (local mock gateway), or "live" (official Ring API)
RING_MODE=demo
RING_API_URL=https://api.ring.com/clients_api/
RING_API_TOKEN=
RING_REFRESH_TOKEN=
RING_DEVICE_IDS=front-door-bell,backyard-cam,living-room-indoor

# AI Service Configuration (Amazon Bedrock)
# AI_MODE: "mock" (default fallback for zero-setup demo) or "bedrock" (calls real AWS Bedrock API)
AI_MODE=mock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Database Configuration (Amazon DynamoDB)
# STORAGE_MODE: "local" (in-memory persistent store) or "dynamodb" (real AWS DynamoDB tables)
STORAGE_MODE=local
DYNAMODB_TABLE_EVENTS=guardianx-events
DYNAMODB_TABLE_INCIDENTS=guardianx-incidents
DYNAMODB_TABLE_CAREGIVERS=guardianx-caregivers

# Cloud Storage Configuration (Amazon S3)
# S3_MODE: "local" (local disk directory) or "s3" (real AWS S3 bucket)
S3_MODE=local
S3_BUCKET=guardianx-event-snapshots
S3_REGION=us-east-1

# Demo Scenario Controls
DEMO_EVENT_DELAY_MS=1500
AUTO_ANALYZE_SAFETY_EVENTS=true
