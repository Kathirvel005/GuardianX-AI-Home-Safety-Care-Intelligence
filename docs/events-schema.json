{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HomeEvent",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "source": { "type": "string", "enum": ["ring", "simulator", "demo"] },
    "deviceId": { "type": "string" },
    "deviceName": { "type": "string" },
    "location": { "type": "string" },
    "eventType": {
      "type": "string",
      "enum": [
        "motion",
        "person_detected",
        "package_detected",
        "door_opened",
        "door_closed",
        "visitor_detected",
        "unknown_person",
        "possible_fall",
        "prolonged_presence",
        "unusual_activity",
        "system_event"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "durationSeconds": { "type": "number" },
    "responseDetected": { "type": "boolean" },
    "metadata": { "type": "object" }
  },
  "required": ["id", "timestamp", "source", "deviceId", "location", "eventType", "confidence"]
}
