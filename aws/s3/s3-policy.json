{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GuardianXPrivateAccess",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::ACCOUNT_ID:role/GuardianXBackendRole"
      },
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::guardianx-event-snapshots/*"
    }
  ]
}
